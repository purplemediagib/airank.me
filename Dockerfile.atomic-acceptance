# Diagnostic image only. The ordinary Dockerfile and service defaults are unchanged.
FROM node:22-alpine
ARG BUILD_REVISION=unknown
ENV AIRANK_BUILD_REVISION=$BUILD_REVISION
WORKDIR /app
COPY app/package.json app/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node app/src ./app/src
COPY --chown=node:node app/data ./app/data
COPY --chown=node:node diagnostics/atomic-acceptance/*.mjs diagnostics/atomic-acceptance/*.json ./diagnostics/atomic-acceptance/
COPY --chown=node:node scripts/verify-atomic-package.mjs ./scripts/verify-atomic-package.mjs
ENV NODE_ENV=production APP_ENV=staging MONITORING_ENABLED=false CONSUMER_COLLECTION_ENABLED=false PROJECT_SCHEDULER_ENABLED=false
LABEL org.opencontainers.image.source="https://github.com/purplemediagib/airank.me" org.opencontainers.image.title="AI Rank inert atomic acceptance diagnostic"
USER node
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3003/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "diagnostics/atomic-acceptance/hold.mjs"]
