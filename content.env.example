PORT=3002
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=
OPENROUTER_API_KEY=
# Explicit model ID supported by your OpenRouter account. No silent fallback.
CONTENT_MODEL=
CONTENT_ENCRYPTION_KEY=
CONTENT_DAILY_BUDGET_USD=10
CONTENT_PROJECT_DAILY_BUDGET_USD=2
CONTENT_CALL_RESERVATION_USD=0.50
GOOGLE_CONNECTOR_BASE_URL=https://mc-kvj7j25914.bunny.run
GOOGLE_CONNECTOR_API_KEY=
# Optional legacy override. On 0.21+ the authorised stored project ID is used by default.
# Never derive the workspace from browser headers.
CONTENT_GOOGLE_WORKSPACES_JSON={}

# Existing API also needs CONTENT_ENCRYPTION_KEY (same value), plus CONTENT_MODEL
# and OPENROUTER_API_KEY for configuration status. It does not perform generation.
